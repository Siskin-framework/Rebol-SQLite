;github: @sqlite-vec
github: asg017/sqlite-vec

compiler: clang
version: 3.53.4

;define: USE_TRACES

#if Windows? [ define: TO_WINDOWS define: _CRT_SECURE_NO_WARNINGS upx: on]
#if macOS?   [ define: TO_OSX     define: HAS_BOOL]
#if Linux?   [ define: TO_LINUX   compiler: gcc]
#if BSD?     [ compiler: clang  ]

target-x86: [
	arch: x86
	#if Windows? [ defines: [ TO_WIN32 _WIN32 ] ]
	#if Linux?   [ defines: [ TO_LINUX_X86    ] ]
]
target-x64: [
	arch: x64
	defines: [
		_FILE_OFFSET_BITS=64
		__LP64__ ; has long (integer) 64 bits
	]
	#if Windows? [ defines: [ TO_WIN32_X64 _WIN32 ] ]
	#if Linux?   [ defines: [ TO_LINUX_X64        ] ]
	#if macOS?   [ defines: [ TO_OSX_X64          ] flags: "-arch x86_64" ]
]

target-arm64: [
	arch: arm64
	;flags: "-arch arm64"
	#if macOS? [
		flags: "-target arm64-apple-darwin"
	]
	define: _FILE_OFFSET_BITS=64
	define: __LP64__ ; has long (integer) 64 bits
	define: __arm64__
	define: TO_OSX_X64
]

r3-extension: [
	clean: %src/sqlite.c
	files: only [
		%sqlite/sqlite3.c
		%sqlite/sqlite-vec.c
		%src/sqlite.c
		%src/sqlite-commands.c
		%src/gen-sqlite.c
	]
	include: [
		%src/
		%sqlite/
	]
	defines: [ENDIAN_LITTLE SQLITE_CORE]
	cflags:  [-fpermissive]
	flags:   [-O2 shared]

	#if Posix? [
		cflags: [-fPIC -pthread ]
		;libraries: [%pthread]
	]
	define: REB_EXT
	do %make-extension.r3 "${NEST_ROOT}/src/sqlite.reb"

	;- keep the README's reference sections in sync with the same spec ----
	do %make-readme.r3 [%src/sqlite.reb]
]

eggs: [
	"Rebol sqlite extension: x86" [
		name: %sqlite-x86
		:r3-extension
		:target-x86
	]
	"Rebol sqlite extension: x64" [
		name: %sqlite-x64
		:r3-extension
		:target-x64
	]
	"Rebol sqlite extension: arm64" [
		name: %sqlite-arm64
		:r3-extension
		:target-arm64
	]
]
